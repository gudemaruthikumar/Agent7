      "architecture": "TrustLensAI Platform",
      "layer": "L3 · Evaluation & Assurance (AAJ)",
      "logs_telemetry": "Evaluation-run log",
      "key_fields": "evaluator/judge outputs, claim-support, metric scores, eval traces",
      "ingested_by": "Consumes generation/retrieval/citation logs + gold datasets",
      "related_metric_families": [
        "Groundedness",
        "Answer Quality",
        "Attribution"
      ],
      "notes": "AAJ 11-agent / 15-step pipeline"
    },
    {
      "index": 19,
      "architecture": "TrustLensAI Platform",
      "layer": "L4 · Metric Library",
      "logs_telemetry": "Metric-definition log",
      "key_fields": "metric defs, thresholds, mappings, gold datasets, versions",
