{
  "library_id": "trustlensai-rag-logs-layers",
  "version": "v1",
  "source": "TrustLensAI_RAG_Logs_Layers_Formulas.xlsx — sheet 'Logs ↔ Architecture Layers'",
  "notes": "Each RAG pipeline stage emits telemetry; TrustLensAI platform layers (L0–L9) ingest and evaluate it. TrustLensAI produces evidence; it does not certify compliance.",
  "layers": [
    {
      "index": 1,
      "architecture": "AI Product (RAG)",
      "layer": "Data Ingestion",
      "logs_telemetry": "Ingestion log",
      "key_fields": "source document IDs, connector, tenant, ingest timestamps, doc versions",
      "ingested_by": "L0 · Foundation & Integration → L1 · Instrumentation & Telemetry",
      "related_metric_families": [
        "Corpus Quality"
      ],
      "notes": "Provenance & lineage of source content"
    },
    {
      "index": 2,
      "architecture": "AI Product (RAG)",
      "layer": "Preprocessing & Chunking",
      "logs_telemetry": "Chunking log",
      "key_fields": "chunk IDs, chunk sizes, overlap, parent-doc mapping",
      "ingested_by": "L1 · Instrumentation & Telemetry",
      "related_metric_families": [
        "Corpus Quality"
      ],
      "notes": "Feeds CQ-01/02/03"
    },
    {
      "index": 3,
      "architecture": "AI Product (RAG)",
      "layer": "Embedding",
      "logs_telemetry": "Embedding log",
      "key_fields": "embedding vectors (refs), embedder model & version",
      "ingested_by": "L1 · Instrumentation & Telemetry",
      "related_metric_families": [
        "Corpus Quality",
        "Retrieval Effectiveness"
      ],
      "notes": "Vector refs only; raw content stays in-perimeter"
