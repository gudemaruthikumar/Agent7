    {
      "index": 15,
      "architecture": "TrustLensAI Platform",
      "layer": "L0 · Foundation & Integration",
      "logs_telemetry": "Registration / asset / connector / IAM log",
      "key_fields": "registered product, connector, tenancy, asset registry",
      "ingested_by": "Consumes onboarding config; anchors identity for all logs",
      "related_metric_families": [],
      "notes": "Endpoint discovery per onboarding wizard"
    },
    {
      "index": 16,
      "architecture": "TrustLensAI Platform",
      "layer": "L1 · Instrumentation & Telemetry",
      "logs_telemetry": "Canonical event log (post-ingest)",
