      "index": 14,
      "architecture": "AI Product (RAG)",
      "layer": "Monitoring & Lifecycle",
      "logs_telemetry": "Monitoring telemetry",
      "key_fields": "metric snapshots, drift, incidents, versions, log-completeness",
