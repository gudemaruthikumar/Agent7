      "architecture": "AI Product (RAG)",
      "layer": "Serving & Infrastructure",
      "logs_telemetry": "Serving telemetry",
      "key_fields": "latency, tokens, cost, throughput, cache hits",
      "ingested_by": "L1 · Instrumentation & Telemetry",
      "related_metric_families": [
        "Efficiency & Ops"
