      "related_metric_families": [
        "Response Quality"
      ],
      "notes": "Final response artifact"
    },
    {
      "index": 11,
      "architecture": "AI Product (Chat)",
      "layer": "Serving & Monitoring",
      "logs_telemetry": "Serving / monitoring telemetry",
      "key_fields": "latency, cost per conversation, throughput, drift, incidents",
