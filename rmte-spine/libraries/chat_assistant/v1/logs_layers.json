      "architecture": "TrustLensAI Platform",
      "layer": "L0 · Foundation & Integration",
      "logs_telemetry": "Registration / asset / connector / IAM log",
      "key_fields": "registered chat product, channel connectors, tenancy, persona registry",
      "ingested_by": "Anchors identity, tenancy & persona/policy for all logs",
      "related_metric_families": [
        "Privacy"
      ],
      "notes": "Persona/policy registry origin"
    },
    {
      "index": 13,
      "architecture": "TrustLensAI Platform",
      "layer": "L1 · Instrumentation & Telemetry",
      "logs_telemetry": "Canonical event log (post-ingest)",
      "key_fields": "normalized chat spans/events, redaction applied, event-bus refs",
      "ingested_by": "Consumes all chat product logs; normalizes & redacts",
      "related_metric_families": [
        "All"
      ],
      "notes": "Raw content redacted at capture (in-perimeter)"
    },
    {
      "index": 14,
      "architecture": "TrustLensAI Platform",
      "layer": "L2 · Observability",
      "logs_telemetry": "Trace / dependency log",
      "key_fields": "reconstructed conversation traces, dependency views, time-series",
      "ingested_by": "Consumes canonical events (D1-gated / target)",
      "related_metric_families": [
        "Conversational",
        "Lifecycle"
      ],
      "notes": "Amber — D1-gated"
    },
    {
      "index": 15,
      "architecture": "TrustLensAI Platform",
      "layer": "L3 · Evaluation & Assurance (AAJ)",
      "logs_telemetry": "Evaluation-run log",
      "key_fields": "evaluator/judge outputs, rubric scores, hallucination, metric scores",
