      "related_metric_families": [
        "Response Quality",
        "Factual Accuracy",
        "Refusal Correctness"
      ],
      "notes": "AAJ 11-agent / 15-step pipeline"
    },
    {
      "index": 16,
      "architecture": "TrustLensAI Platform",
      "layer": "L4 · Metric Library",
      "logs_telemetry": "Metric-definition log",
      "key_fields": "metric defs, thresholds, mappings, gold sets & rubrics, versions",
      "ingested_by": "Supplies formulas/thresholds & reference data to L3",
      "related_metric_families": [
        "All"
      ],
      "notes": "Governs the Chat RMTE metric corpus"
    },
    {
      "index": 17,
      "architecture": "TrustLensAI Platform",
      "layer": "L5 · Risk & Governance (Gates 0–4)",
      "logs_telemetry": "Policy / gate log",
      "key_fields": "safety, content-policy, privacy decisions, risk register, gates",
      "ingested_by": "Consumes evaluation evidence; runs release gates",
      "related_metric_families": [
        "Safety",
        "Privacy",
        "Adversarial"
      ],
      "notes": "Gates 0–4; safety-critical controls"
    },
    {
      "index": 18,
      "architecture": "TrustLensAI Platform",
      "layer": "L6 · Evidence & Trust Score",
      "logs_telemetry": "Evidence-Pack log",
      "key_fields": "Evidence Pack manifest, RFC 6962 inclusion proofs / hashes, Trust Score (Q6)",
      "ingested_by": "Assembles tamper-evident evidence + verdict",
      "related_metric_families": [
        "All"
      ],
      "notes": "Trust Score = governed Q6 placeholder"
    },
    {
      "index": 19,
      "architecture": "TrustLensAI Platform",
      "layer": "L9 · Experience & Reporting",
      "logs_telemetry": "Reporting / notification log",
      "key_fields": "persona surfaces, scorecards, reports, notifications",
      "ingested_by": "Consumes evidence & verdicts for reporting",
      "related_metric_families": [
        "All"
      ],
      "notes": "Executive / Engineering / Risk personas"
    }
