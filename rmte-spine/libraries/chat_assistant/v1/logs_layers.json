      "related_metric_families": [
        "Factual Accuracy"
      ],
      "notes": "Optional — RAG-augmented chat"
    },
    {
      "index": 5,
      "architecture": "AI Product (Chat)",
      "layer": "Prompt Orchestration",
      "logs_telemetry": "Prompt log",
      "key_fields": "prompt, system-prompt version, persona template, assembled context",
      "ingested_by": "L1 · Instrumentation & Telemetry",
      "related_metric_families": [
        "Response Quality"
      ],
      "notes": "Prompt/persona version governance"
    },
    {
