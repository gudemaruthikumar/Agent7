{
  "library_id": "tlai-rmte-chat_assistant-logs-layers",
  "version": "v1",
  "source": "TrustLensAI_ChatAssistant_Logs_Layers_Formulas.xlsx — sheet 'Chat Assistant RMTE (Master)' plus 'Logs ↔ Formula Inputs' and 'Logs ↔ Architecture Layers'",
  "notes": "Each Chat Assistant pipeline stage emits telemetry; TrustLensAI platform layers ingest and evaluate it. TrustLensAI produces evidence; it does not certify compliance.",
  "layers": [
    {
      "index": 1,
      "architecture": "AI Product (Chat)",
      "layer": "Input / Intent",
      "logs_telemetry": "Input log",
      "key_fields": "user message, parsed intent, disambiguation request",
      "ingested_by": "L0 · Foundation & Integration → L1 · Instrumentation & Telemetry",
      "related_metric_families": [
        "Conversational"
      ],
      "notes": "Feeds CA-04 disambiguation"
    },
    {
      "index": 2,
      "architecture": "AI Product (Chat)",
      "layer": "Dialogue / Context Management",
      "logs_telemetry": "Dialogue log",
      "key_fields": "conversation history, turn coherence, referenced prior turns",
      "ingested_by": "L1 · Instrumentation & Telemetry → L3 · Evaluation & Assurance",
      "related_metric_families": [
        "Conversational"
      ],
      "notes": "Feeds CA-01/02/03"
    },
    {
      "index": 3,
      "architecture": "AI Product (Chat)",
      "layer": "Session Memory",
      "logs_telemetry": "Session-memory log",
      "key_fields": "session state, cross-session isolation, retention",
      "ingested_by": "L1 · Instrumentation & Telemetry → L5 · Risk & Governance",
      "related_metric_families": [
        "Privacy"
      ],
      "notes": "Feeds PV-02 session isolation"
    },
    {
      "index": 4,
      "architecture": "AI Product (Chat)",
      "layer": "Grounding / Retrieval",
      "logs_telemetry": "Retrieval log",
