      "related_metric_families": [
        "Privacy",
        "Safety"
      ],
      "notes": "Feeds PV-04, SC-03"
    },
    {
      "index": 8,
      "architecture": "AI Product (Chat)",
      "layer": "Guardrails / Safety",
      "logs_telemetry": "Guardrail log",
      "key_fields": "safety-classifier, toxicity, PII-detector, injection/jailbreak verdicts",
